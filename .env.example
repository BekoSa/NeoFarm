# --- General ---
TZ=UTC

# --- Postgres ---
POSTGRES_DB=farm
POSTGRES_USER=farm
POSTGRES_PASSWORD=farm
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_POOL_SIZE=10
POSTGRES_MAX_OVERFLOW=20

# --- Redis ---
REDIS_HOST=redis
REDIS_PORT=6379

# --- Farm server ---
# API key that clients/CLI must send in `X-Farm-Token`. The server refuses
# to start with an empty or the default value — generate one, e.g.:
#   python3 -c 'import secrets; print(secrets.token_urlsafe(24))'
FARM_API_TOKEN=change-me-please
# Where the API listens inside the container; map to host in docker-compose.
FARM_HOST=0.0.0.0
FARM_PORT=5000
# Path inside the container to the YAML config (mounted from ./config.yml).
FARM_CONFIG=/app/config.yml
# CORS origins for the frontend (comma-separated, * for all).
FARM_CORS_ORIGINS=*

# --- Images ---
# Where `docker compose pull` gets prebuilt images, and which tag.
# FARM_IMAGE_REPO=ghcr.io/bekosa/neofarm
# FARM_TAG=latest

# --- Frontend ---
# Leave empty: the UI (port 8080) proxies the API itself, so it works on any
# host. Set only to point the UI at an API on another host (build-time).
VITE_API_BASE=
